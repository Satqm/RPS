    <script>
        (function() {
            // ============ CONSTANTS ============
            const DB_NAME = 'RPS_Planner_DB';
            const DB_VERSION = 2;
            const CLASSES = ['VI', 'VII', 'VIII', 'IX', 'X', 'XI', 'XII'];
            const SECTIONS_MAP = {
                'VI': ['A', 'B', 'C'],
                'VII': ['A', 'B', 'C'],
                'VIII': ['A', 'B', 'C', 'D'],
                'IX': ['A', 'B', 'C', 'D', 'E'],
                'X': ['A', 'B', 'C', 'D', 'E'],
                'XI': ['A', 'B', 'C'],
                'XII': ['A', 'B', 'C']
            };
            const SUBJECTS = ['Physics', 'Chemistry', 'Biology'];
            const PERIODS = [2, 3, 4, 5, 6, 7]; // Periods 2nd to 7th
            const CLASS_ORDER = {};
            CLASSES.forEach((c, i) => { CLASS_ORDER[c] = i; });
            const SUBJECT_ORDER = { 'Physics': 0, 'Chemistry': 1, 'Biology': 2 };

            const TODAY = new Date();
            const dateStr = (d) => d.toISOString().split('T')[0];

            let currentView = 'today';
            let currentDate = dateStr(TODAY);
            let calMonth = TODAY.getMonth();
            let calYear = TODAY.getFullYear();
            let db = null;
            let darkMode = false;

            // ============ INDEXED DB ============
            function openDB() {
                return new Promise((resolve, reject) => {
                    const req = indexedDB.open(DB_NAME, DB_VERSION);
                    req.onupgradeneeded = (e) => {
                        const d = e.target.result;
                        if (!d.objectStoreNames.contains('progress')) {
                            d.createObjectStore('progress', { keyPath: 'id' });
                        }
                        if (!d.objectStoreNames.contains('schedule')) {
                            const s = d.createObjectStore('schedule', { keyPath: 'id',
                            autoIncrement: true });
                            s.createIndex('date', 'date', { unique: false });
                            s.createIndex('date_period', ['date', 'period'], { unique: true });
                        }
                        if (!d.objectStoreNames.contains('settings')) {
                            d.createObjectStore('settings', { keyPath: 'key' });
                        }
                    };
                    req.onsuccess = (e) => { db = e.target.result;
                        resolve(db); };
                    req.onerror = (e) => reject(e.target.error);
                });
            }

            function dbPut(storeName, data) {
                return new Promise((resolve, reject) => {
                    const tx = db.transaction(storeName, 'readwrite');
                    const store = tx.objectStore(storeName);
                    store.put(data);
                    tx.oncomplete = () => resolve();
                    tx.onerror = (e) => reject(e.target.error);
                });
            }

            function dbGetAll(storeName) {
                return new Promise((resolve, reject) => {
                    const tx = db.transaction(storeName, 'readonly');
                    const store = tx.objectStore(storeName);
                    const req = store.getAll();
                    req.onsuccess = () => resolve(req.result);
                    req.onerror = (e) => reject(e.target.error);
                });
            }

            function dbGet(storeName, key) {
                return new Promise((resolve, reject) => {
                    const tx = db.transaction(storeName, 'readonly');
                    const store = tx.objectStore(storeName);
                    const req = store.get(key);
                    req.onsuccess = () => resolve(req.result);
                    req.onerror = (e) => reject(e.target.error);
                });
            }

            function dbDelete(storeName, key) {
                return new Promise((resolve, reject) => {
                    const tx = db.transaction(storeName, 'readwrite');
                    const store = tx.objectStore(storeName);
                    store.delete(key);
                    tx.oncomplete = () => resolve();
                    tx.onerror = (e) => reject(e.target.error);
                });
            }

            function dbClear(storeName) {
                return new Promise((resolve, reject) => {
                    const tx = db.transaction(storeName, 'readwrite');
                    const store = tx.objectStore(storeName);
                    store.clear();
                    tx.oncomplete = () => resolve();
                    tx.onerror = (e) => reject(e.target.error);
                });
            }

            async function getScheduleForDate(date) {
                const all = await dbGetAll('schedule');
                const result = {};
                PERIODS.forEach(p => { result[p] = null; });
                all.filter(s => s.date === date).forEach(s => { result[s.period] = s; });
                return result;
            }

            async function getAllProgress() {
                return await dbGetAll('progress');
            }

            async function initProgressIfEmpty() {
                const existing = await dbGetAll('progress');
                if (existing.length === 0) {
                    for (const cls of CLASSES) {
                        for (const subj of SUBJECTS) {
                            await dbPut('progress', {
                                id: `${cls}_${subj}`,
                                class: cls,
                                subject: subj,
                                currentSectionIndex: 0
                            });
                        }
                    }
                }
            }

            async function initSettingsIfEmpty() {
                const s = await dbGet('settings', 'app');
                if (!s) {
                    await dbPut('settings', { key: 'app', teacherName: 'Mr. Mithilesh', darkMode: false });
                    darkMode = false;
                } else {
                    darkMode = s.darkMode || false;
                    applyDarkMode(darkMode);
                    document.getElementById('settingTeacherName').value = s.teacherName || 'Mr. Mithilesh';
                    document.getElementById('toggleDarkMode').checked = darkMode;
                    document.getElementById('darkModeLabel').textContent = darkMode ? 'On' : 'Off';
                }
            }

            function applyDarkMode(enable) {
                darkMode = enable;
                if (enable) {
                    document.body.classList.add('dark-mode');
                } else {
                    document.body.classList.remove('dark-mode');
                }
                document.getElementById('darkModeLabel').textContent = enable ? 'On' : 'Off';
                document.getElementById('toggleDarkMode').checked = enable;
            }

            // ============ DIVERSE RECOMMENDATION ENGINE ============
            async function getDiverseRecommendations(count = 6) {
                const progress = await getAllProgress();
                const sectionsMap = SECTIONS_MAP;
                const allCandidates = [];

                for (const p of progress) {
                    const totalSections = (sectionsMap[p.class] || []).length;
                    if (p.currentSectionIndex < totalSections) {
                        const nextSection = sectionsMap[p.class][p.currentSectionIndex];
                        allCandidates.push({
                            class: p.class,
                            section: nextSection,
                            subject: p.subject,
                            progressEntry: p,
                            sectionsRemaining: totalSections - p.currentSectionIndex,
                            inProgress: p.currentSectionIndex > 0,
                            totalSections,
                            currentIndex: p.currentSectionIndex
                        });
                    }
                }

                if (allCandidates.length === 0) return [];

                // Group by class
                const grouped = {};
                for (const c of allCandidates) {
                    if (!grouped[c.class]) grouped[c.class] = [];
                    grouped[c.class].push(c);
                }

                // Sort groups: classes with in-progress sections first, then by class order
                const sortedClasses = Object.keys(grouped).sort((a, b) => {
                    const aHasInProgress = grouped[a].some(c => c.inProgress);
                    const bHasInProgress = grouped[b].some(c => c.inProgress);
                    if (aHasInProgress && !bHasInProgress) return -1;
                    if (!aHasInProgress && bHasInProgress) return 1;
                    return (CLASS_ORDER[a] ?? 99) - (CLASS_ORDER[b] ?? 99);
                });

                // Sort within each group: in-progress first, then by subject order
                for (const cls of sortedClasses) {
                    grouped[cls].sort((a, b) => {
                        if (a.inProgress && !b.inProgress) return -1;
                        if (!a.inProgress && b.inProgress) return 1;
                        return (SUBJECT_ORDER[a.subject] ?? 99) - (SUBJECT_ORDER[b.subject] ?? 99);
                    });
                }

                // Round-robin selection across classes for diversity
                const result = [];
                const indices = {};
                sortedClasses.forEach(cls => { indices[cls] = 0; });

                while (result.length < count && sortedClasses.some(cls => indices[cls] < (grouped[cls] || []).length)) {
                    for (const cls of sortedClasses) {
                        if (result.length >= count) break;
                        const group = grouped[cls] || [];
                        if (indices[cls] < group.length) {
                            result.push(group[indices[cls]]);
                            indices[cls]++;
                        }
                    }
                }

                return result;
            }

            // ============ RENDER TODAY VIEW ============
            async function renderToday(date) {
                currentDate = date;
                document.getElementById('todayDateLabel').textContent = formatDateNice(date);
                document.getElementById('headerDate').textContent = formatDateShort(date);
                document.getElementById('todayNavBadge').textContent = formatDateShort(date);
                const schedule = await getScheduleForDate(date);
                const grid = document.getElementById('periodGrid');
                const searchTerm = (document.getElementById('searchClass')?.value || '').trim().toUpperCase();

                let html = '';
                for (const p of PERIODS) {
                    const entry = schedule[p];
                    let cardClass = '';
                    let statusBadge = '';
                    let statusClass = 'status-not-started';
                    let classInfo = '<span style="color:#999;font-style:italic;">No class scheduled</span>';
                    let subjectInfo = '';
                    let notesPreview = '';

                    if (entry) {
                        if (entry.status === 'completed') {
                            cardClass = 'completed';
                            statusBadge = '✅ Completed';
                            statusClass = 'status-completed';
                        } else if (entry.status === 'skipped') {
                            cardClass = 'skipped';
                            statusBadge = '⏭️ Skipped';
                            statusClass = 'status-skipped';
                        } else {
                            statusBadge = '⏳ Not Started';
                            statusClass = 'status-not-started';
                        }
                        classInfo = `<strong>Class ${entry.class} — Section ${entry.section}</strong>`;
                        subjectInfo = entry.subject;
                        notesPreview = entry.notes ? `📝 ${entry.notes}` : '';
                    }

                    // Search filter
                    if (searchTerm && entry) {
                        const haystack =
                            `${entry.class} ${entry.section} ${entry.subject} ${entry.notes||''}`.toUpperCase();
                        if (!haystack.includes(searchTerm)) {
                            continue; // skip this card
                        }
                    }

                    html += `
                <div class="period-card ${cardClass}" data-period="${p}">
                  <span class="period-chip">Period ${p}</span>
                  <div class="class-title">${classInfo}</div>
                  ${subjectInfo ? `<div class="subject-tag">📖 ${subjectInfo}</div>` : ''}
                  ${statusBadge ? `<span class="status-pill ${statusClass}">${statusBadge}</span>` : ''}
                  ${notesPreview ? `<div class="notes-snippet">${notesPreview}</div>` : ''}
                  <div class="card-actions-row">
                    <button class="btn btn-outline btn-sm btn-edit-period" data-period="${p}">✏️ Edit</button>
                    ${entry ? `<button class="btn btn-success btn-sm btn-mark-done" data-period="${p}">✅ Done</button>` : ''}
                    ${entry ? `<button class="btn btn-warn btn-sm btn-mark-skip" data-period="${p}">⏭️ Skip</button>` : ''}
                  </div>
                </div>`;
                }
                grid.innerHTML = html || '<p style="color:var(--gray-500);text-align:center;padding:20px;">No periods match your search.</p>';

                // Attach listeners
                grid.querySelectorAll('.btn-edit-period').forEach(btn => {
                    btn.addEventListener('click', () => openEditModal(parseInt(btn.dataset.period)));
                });
                grid.querySelectorAll('.btn-mark-done').forEach(btn => {
                    btn.addEventListener('click', async () => {
                        await quickUpdateStatus(parseInt(btn.dataset.period), 'completed');
                        await renderToday(currentDate);
                        if (currentView === 'calendar') await renderCalendar();
                    });
                });
                grid.querySelectorAll('.btn-mark-skip').forEach(btn => {
                    btn.addEventListener('click', async () => {
                        await quickUpdateStatus(parseInt(btn.dataset.period), 'skipped');
                        await renderToday(currentDate);
                        if (currentView === 'calendar') await renderCalendar();
                    });
                });
            }

            async function quickUpdateStatus(period, status) {
                const schedule = await getScheduleForDate(currentDate);
                const entry = schedule[period];
                if (!entry) return;
                entry.status = status;
                await dbPut('schedule', entry);
                if (status === 'completed') {
                    await advanceProgress(entry.class, entry.subject);
                }
            }

            async function advanceProgress(cls, subject) {
                const key = `${cls}_${subject}`;
                const prog = await dbGet('progress', key);
                if (!prog) return;
                const total = (SECTIONS_MAP[cls] || []).length;
                if (prog.currentSectionIndex < total) {
                    prog.currentSectionIndex++;
                    await dbPut('progress', prog);
                }
            }

            // ============ EDIT MODAL ============
            async function openEditModal(period) {
                const schedule = await getScheduleForDate(currentDate);
                const entry = schedule[period];
                document.getElementById('editPeriodIndex').value = period;

                // Populate class dropdown
                const classSel = document.getElementById('editClass');
                classSel.innerHTML = CLASSES.map(c =>
                    `<option value="${c}" ${c===(entry?.class||'VI')?'selected':''}>Class ${c}</option>`
                ).join('');
                classSel.value = entry?.class || 'VI';

                // Populate section dropdown based on selected class
                updateSectionDropdown(classSel.value, entry?.section || 'A');

                // POPULATE SUBJECT DROPDOWN (this was the bug - it was empty!)
                const subjectSel = document.getElementById('editSubject');
                subjectSel.innerHTML = SUBJECTS.map(s =>
                    `<option value="${s}" ${s===(entry?.subject||'Physics')?'selected':''}>${s}</option>`
                ).join('');
                subjectSel.value = entry?.subject || 'Physics';

                // Set status
                document.getElementById('editStatus').value = entry?.status || 'not-started';
                document.getElementById('editNotes').value = entry?.notes || '';
                document.getElementById('editModalOverlay').classList.remove('hidden');

                // Wire up class change to update sections
                classSel.onchange = function() {
                    updateSectionDropdown(this.value, null);
                };
            }

            function updateSectionDropdown(cls, selectedSection) {
                const sel = document.getElementById('editSection');
                const sections = SECTIONS_MAP[cls] || ['A'];
                sel.innerHTML = sections.map(s =>
                    `<option value="${s}" ${s===selectedSection?'selected':''}>Section ${s}</option>`
                ).join('');
                if (selectedSection && sections.includes(selectedSection)) {
                    sel.value = selectedSection;
                }
            }

            document.getElementById('btnCancelEdit').addEventListener('click', () => {
                document.getElementById('editModalOverlay').classList.add('hidden');
            });

            document.getElementById('btnSaveEdit').addEventListener('click', async () => {
                const period = parseInt(document.getElementById('editPeriodIndex').value);
                const cls = document.getElementById('editClass').value;
                const section = document.getElementById('editSection').value;
                const subject = document.getElementById('editSubject').value;
                const status = document.getElementById('editStatus').value;
                const notes = document.getElementById('editNotes').value.trim();

                const schedule = await getScheduleForDate(currentDate);
                let entry = schedule[period];

                if (entry) {
                    entry.class = cls;
                    entry.section = section;
                    entry.subject = subject;
                    entry.status = status;
                    entry.notes = notes;
                } else {
                    entry = {
                        date: currentDate,
                        period: period,
                        class: cls,
                        section: section,
                        subject: subject,
                        status: status,
                        notes: notes
                    };
                }
                await dbPut('schedule', entry);

                if (status === 'completed') {
                    await advanceProgress(cls, subject);
                }

                document.getElementById('editModalOverlay').classList.add('hidden');
                await renderToday(currentDate);
                if (currentView === 'calendar') await renderCalendar();
            });

            document.getElementById('editModalOverlay').addEventListener('click', function(e) {
                if (e.target === this) this.classList.add('hidden');
            });

            // ============ SMART SUGGESTIONS & AUTO FILL ============
            document.getElementById('btnSmartSuggest').addEventListener('click', async () => {
                const recs = await getDiverseRecommendations(6);
                // Clear current day schedule
                const existing = await getScheduleForDate(currentDate);
                for (const p of PERIODS) {
                    if (existing[p]) await dbDelete('schedule', existing[p].id);
                }
                // Fill with diverse recommendations
                for (let i = 0; i < Math.min(recs.length, PERIODS.length); i++) {
                    const r = recs[i];
                    await dbPut('schedule', {
                        date: currentDate,
                        period: PERIODS[i],
                        class: r.class,
                        section: r.section,
                        subject: r.subject,
                        status: 'not-started',
                        notes: ''
                    });
                }
                await renderToday(currentDate);
                if (currentView === 'calendar') await renderCalendar();
            });

            document.getElementById('btnAutoFill').addEventListener('click', async () => {
                const recs = await getDiverseRecommendations(6);
                const existing = await getScheduleForDate(currentDate);
                const filledPeriods = new Set();
                for (const p of PERIODS) {
                    if (existing[p]) filledPeriods.add(p);
                }
                const emptyPeriods = PERIODS.filter(p => !filledPeriods.has(p));
                for (let i = 0; i < Math.min(recs.length, emptyPeriods.length); i++) {
                    const r = recs[i];
                    await dbPut('schedule', {
                        date: currentDate,
                        period: emptyPeriods[i],
                        class: r.class,
                        section: r.section,
                        subject: r.subject,
                        status: 'not-started',
                        notes: ''
                    });
                }
                await renderToday(currentDate);
                if (currentView === 'calendar') await renderCalendar();
            });

            // Search
            document.getElementById('searchClass').addEventListener('input', async () => {
                await renderToday(currentDate);
            });

            // ============ CALENDAR VIEW ============
            async function renderCalendar() {
                document.getElementById('calMonthLabel').textContent =
                    new Date(calYear, calMonth).toLocaleString('default', { month: 'long', year: 'numeric' });
                const grid = document.getElementById('calendarGrid');
                const dayHeaders = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
                let html = dayHeaders.map(d => `<div class="day-hdr">${d}</div>`).join('');

                const firstDay = new Date(calYear, calMonth, 1).getDay();
                const daysInMonth = new Date(calYear, calMonth + 1, 0).getDate();
                const daysInPrevMonth = new Date(calYear, calMonth, 0).getDate();

                const allSchedules = await dbGetAll('schedule');
                const dateStatusMap = {};
                for (const s of allSchedules) {
                    if (!dateStatusMap[s.date]) dateStatusMap[s.date] = { total: 0, completed: 0 };
                    dateStatusMap[s.date].total++;
                    if (s.status === 'completed') dateStatusMap[s.date].completed++;
                }

                function getDayClass(d, m, y) {
                    const ds = dateStr(new Date(y, m, d));
                    const todayStr = dateStr(TODAY);
                    let cls = 'day-cell';
                    if (ds === todayStr) cls += ' today-ring';
                    const info = dateStatusMap[ds];
                    if (info && info.total > 0) {
                        if (info.completed >= info.total) cls += ' completed-day';
                        else if (info.completed > 0) cls += ' partial-day';
                        else cls += ' empty-day';
                    } else if (info && info.total === 0) {
                        cls += ' empty-day';
                    } else {
                        cls += ' empty-day';
                    }
                    return cls;
                }

                // Previous month trailing days
                for (let i = firstDay - 1; i >= 0; i--) {
                    const d = daysInPrevMonth - i;
                    const m = calMonth === 0 ? 11 : calMonth - 1;
                    const y = calMonth === 0 ? calYear - 1 : calYear;
                    html +=
                        `<div class="day-cell other-month" data-date="${dateStr(new Date(y,m,d))}">${d}</div>`;
                }

                // Current month
                for (let d = 1; d <= daysInMonth; d++) {
                    const cls = getDayClass(d, calMonth, calYear);
                    const ds = dateStr(new Date(calYear, calMonth, d));
                    html += `<div class="${cls}" data-date="${ds}">${d}</div>`;
                }

                // Next month leading days
                const totalCells = firstDay + daysInMonth;
                const remaining = totalCells % 7 === 0 ? 0 : 7 - (totalCells % 7);
                for (let d = 1; d <= remaining; d++) {
                    const m = calMonth === 11 ? 0 : calMonth + 1;
                    const y = calMonth === 11 ? calYear + 1 : calYear;
                    html +=
                        `<div class="day-cell other-month" data-date="${dateStr(new Date(y,m,d))}">${d}</div>`;
                }

                grid.innerHTML = html;

                grid.querySelectorAll('.day-cell:not(.other-month)').forEach(cell => {
                    cell.addEventListener('click', async () => {
                        const ds = cell.dataset.date;
                        if (ds) {
                            currentDate = ds;
                            await renderToday(ds);
                            switchView('today');
                        }
                    });
                });
            }

            document.getElementById('calPrev').addEventListener('click', () => {
                calMonth--;
                if (calMonth < 0) { calMonth = 11;
                    calYear--; }
                renderCalendar();
            });
            document.getElementById('calNext').addEventListener('click', () => {
                calMonth++;
                if (calMonth > 11) { calMonth = 0;
                    calYear++; }
                renderCalendar();
            });
            document.getElementById('calGoToday').addEventListener('click', () => {
                calMonth = TODAY.getMonth();
                calYear = TODAY.getFullYear();
                currentDate = dateStr(TODAY);
                renderCalendar();
                renderToday(currentDate);
                switchView('today');
            });

            // ============ ANALYTICS ============
            async function renderAnalytics() {
                const allSchedules = await dbGetAll('schedule');
                const allProgress = await dbGetAll('progress');
                const grid = document.getElementById('analyticsGrid');

                const completedEntries = allSchedules.filter(s => s.status === 'completed');
                const totalCompleted = completedEntries.length;

                // Per class
                const classCounts = {};
                CLASSES.forEach(c => { classCounts[c] = { total: 0, completed: 0, skipped: 0 }; });
                allSchedules.forEach(s => {
                    if (classCounts[s.class]) {
                        classCounts[s.class].total++;
                        if (s.status === 'completed') classCounts[s.class].completed++;
                        if (s.status === 'skipped') classCounts[s.class].skipped++;
                    }
                });

                // Per subject
                const subjectCounts = {};
                SUBJECTS.forEach(s => { subjectCounts[s] = 0; });
                completedEntries.forEach(s => { subjectCounts[s.subject] = (subjectCounts[s.subject] || 0) + 1; });

                // Period utilization
                const periodUsage = {};
                PERIODS.forEach(p => { periodUsage[p] = 0; });
                allSchedules.forEach(s => { periodUsage[s.period] = (periodUsage[s.period] || 0) + 1; });
                const maxPeriodUsage = Math.max(1, ...Object.values(periodUsage));

                // Section coverage
                let coverageHTML = '<ul class="coverage-list">';
                for (const cls of CLASSES) {
                    const sections = SECTIONS_MAP[cls];
                    coverageHTML += `<li><strong>${cls}:</strong> `;
                    sections.forEach(sec => {
                        const hasCompleted = allSchedules.some(s => s.class === cls && s.section ===
                            sec && s.status === 'completed');
                        coverageHTML += hasCompleted ?
                            `<span class="check">${sec}✔</span> ` :
                            `<span class="cross">${sec}❌</span> `;
                    });
                    coverageHTML += '</li>';
                }
                coverageHTML += '</ul>';

                // Monthly progress
                const monthlyData = {};
                allSchedules.forEach(s => {
                    const m = s.date.substring(0, 7);
                    if (!monthlyData[m]) monthlyData[m] = { total: 0, completed: 0 };
                    monthlyData[m].total++;
                    if (s.status === 'completed') monthlyData[m].completed++;
                });
                let monthlyHTML = '';
                const sortedMonths = Object.keys(monthlyData).sort();
                for (const m of sortedMonths.slice(-6)) {
                    const d = monthlyData[m];
                    const pct = d.total > 0 ? Math.round((d.completed / d.total) * 100) : 0;
                    monthlyHTML += `
                <div style="margin:5px 0;">
                  <strong>${m}</strong>: ${d.completed}/${d.total} (${pct}%)
                  <div class="mini-bar-wrap"><div class="mini-bar-fill" style="width:${pct}%;"></div></div>
                </div>`;
                }

                // Pending work
                let pendingHTML = '';
                for (const p of allProgress) {
                    const total = (SECTIONS_MAP[p.class] || []).length;
                    if (p.currentSectionIndex < total) {
                        const nextSec = SECTIONS_MAP[p.class][p.currentSectionIndex];
                        pendingHTML +=
                            `<li>📌 <strong>${p.class} — ${p.subject}</strong>: Next → Section ${nextSec} (${p.currentSectionIndex}/${total} done)</li>`;
                    }
                }
                if (!pendingHTML) pendingHTML = '<li>✅ All sections completed for all classes!</li>';

                grid.innerHTML = `
              <div class="stat-card">
                <h4>📊 Total Practicals Completed</h4>
                <div class="big-num">${totalCompleted}</div>
                <div class="sub-text">Across all classes & subjects</div>
              </div>
              <div class="stat-card">
                <h4>📚 By Subject</h4>
                ${SUBJECTS.map(s => `<div style="margin:4px 0;font-size:0.82rem;"><strong>${s}:</strong> ${subjectCounts[s]||0} completed</div>`).join('')}
              </div>
              <div class="stat-card">
                <h4>🏫 By Class</h4>
                ${CLASSES.map(c => `<div style="margin:3px 0;font-size:0.78rem;"><strong>${c}:</strong> ${classCounts[c].completed}/${classCounts[c].total} done
                  <div class="mini-bar-wrap"><div class="mini-bar-fill" style="width:${classCounts[c].total>0?Math.round((classCounts[c].completed/classCounts[c].total)*100):0}%;"></div></div>
                </div>`).join('')}
              </div>
              <div class="stat-card">
                <h4>🕐 Period Utilization (Periods 2–7)</h4>
                ${PERIODS.map(p => `<div style="margin:3px 0;font-size:0.78rem;"><strong>Period ${p}:</strong> ${periodUsage[p]||0} entries
                  <div class="mini-bar-wrap"><div class="mini-bar-fill" style="width:${Math.round(((periodUsage[p]||0)/maxPeriodUsage)*100)}%;"></div></div>
                </div>`).join('')}
              </div>
              <div class="stat-card">
                <h4>📅 Monthly Progress (Recent)</h4>
                ${monthlyHTML || '<em style="color:var(--gray-500);font-size:0.8rem;">No data yet</em>'}
              </div>
              <div class="stat-card">
                <h4>✅ Section Coverage</h4>
                ${coverageHTML}
              </div>
            `;
                document.getElementById('pendingWorkList').innerHTML = pendingHTML;
            }

            // ============ SETTINGS ============
            document.getElementById('btnSaveSettings').addEventListener('click', async () => {
                const teacherName = document.getElementById('settingTeacherName').value.trim() || 'Mr. Mithilesh';
                const darkModeToggle = document.getElementById('toggleDarkMode').checked;
                await dbPut('settings', { key: 'app', teacherName, darkMode: darkModeToggle });
                document.querySelector('.topbar-teacher').innerHTML =
                    '<span class="dot-live"></span> ' + teacherName;
                applyDarkMode(darkModeToggle);
                alert('✅ Settings saved successfully!');
            });

            document.getElementById('toggleDarkMode').addEventListener('change', function() {
                applyDarkMode(this.checked);
            });

            document.getElementById('btnExportData').addEventListener('click', async () => {
                const progress = await dbGetAll('progress');
                const schedule = await dbGetAll('schedule');
                const settings = await dbGetAll('settings');
                const exportData = { progress, schedule, settings, exportedAt: new Date().toISOString(),
                    version: DB_VERSION };
                const blob = new Blob([JSON.stringify(exportData, null, 2)], { type: 'application/json' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `RPS_Planner_Backup_${dateStr(TODAY)}.json`;
                a.click();
                URL.revokeObjectURL(url);
            });

            document.getElementById('btnImportData').addEventListener('click', () => {
                document.getElementById('importFileInput').click();
            });

            document.getElementById('importFileInput').addEventListener('change', async function() {
                const file = this.files[0];
                if (!file) return;
                try {
                    const text = await file.text();
                    const data = JSON.parse(text);
                    if (!data.progress || !data.schedule || !data.settings) {
                        throw new Error('Invalid backup file structure');
                    }
                    if (!confirm(
                            '⚠️ This will replace ALL current data. Are you sure?')) return;
                    await dbClear('progress');
                    await dbClear('schedule');
                    await dbClear('settings');
                    for (const p of data.progress) await dbPut('progress', p);
                    for (const s of data.schedule) await dbPut('schedule', s);
                    for (const st of data.settings) await dbPut('settings', st);
                    alert('✅ Data imported! Reloading...');
                    location.reload();
                } catch (err) {
                    alert('❌ Import failed: ' + err.message);
                }
                this.value = '';
            });

            document.getElementById('btnResetData').addEventListener('click', async () => {
                if (!confirm('⚠️ Delete ALL data permanently? This cannot be undone.')) return;
                const confirmInput = prompt('Type "yes" to confirm:');
                if (confirmInput !== 'yes') return;
                await dbClear('progress');
                await dbClear('schedule');
                await dbClear('settings');
                alert('✅ All data reset. Reloading...');
                location.reload();
            });

            // ============ VIEW SWITCHING ============
            function switchView(viewName) {
                currentView = viewName;
                document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
                const targetView = document.getElementById('view-' + viewName);
                if (targetView) targetView.classList.add('active');
                document.querySelectorAll('.sidebar-nav button').forEach(b => b.classList.remove('active'));
                const navBtn = document.querySelector(`[data-view="${viewName}"]`);
                if (navBtn) navBtn.classList.add('active');
                if (viewName === 'analytics') renderAnalytics();
                if (viewName === 'calendar') renderCalendar();
                if (viewName === 'today') renderToday(currentDate);
                // Close mobile sidebar
                closeSidebar();
            }

            document.querySelectorAll('.sidebar-nav button').forEach(btn => {
                btn.addEventListener('click', () => {
                    const view = btn.dataset.view;
                    switchView(view);
                });
            });

            // ============ MOBILE SIDEBAR ============
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebarOverlay');
            const hamburgerBtn = document.getElementById('hamburgerBtn');

            function openSidebar() {
                sidebar.classList.add('open');
                overlay.classList.add('active');
                document.body.style.overflow = 'hidden';
            }

            function closeSidebar() {
                sidebar.classList.remove('open');
                overlay.classList.remove('active');
                document.body.style.overflow = '';
            }

            hamburgerBtn.addEventListener('click', () => {
                if (sidebar.classList.contains('open')) {
                    closeSidebar();
                } else {
                    openSidebar();
                }
            });

            overlay.addEventListener('click', closeSidebar);

            // Close sidebar on window resize if it becomes desktop
            window.addEventListener('resize', () => {
                if (window.innerWidth > 900) {
                    closeSidebar();
                }
            });

            // ============ KEYBOARD SHORTCUTS ============
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') {
                    document.getElementById('editModalOverlay').classList.add('hidden');
                    closeSidebar();
                }
            });

            // ============ HELPERS ============
            function formatDateNice(dateStrVal) {
                const d = new Date(dateStrVal + 'T00:00:00');
                const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
                return d.toLocaleDateString('en-US', options);
            }

            function formatDateShort(dateStrVal) {
                const d = new Date(dateStrVal + 'T00:00:00');
                const options = { month: 'short', day: 'numeric', year: 'numeric' };
                return d.toLocaleDateString('en-US', options);
            }

            // ============ INITIALIZATION ============
            async function init() {
                await openDB();
                await initProgressIfEmpty();
                await initSettingsIfEmpty();
                document.getElementById('headerDate').textContent = formatDateShort(currentDate);
                document.getElementById('todayDateLabel').textContent = formatDateNice(currentDate);
                document.getElementById('todayNavBadge').textContent = formatDateShort(currentDate);
                const settings = await dbGet('settings', 'app');
                if (settings) {
                    document.getElementById('settingTeacherName').value = settings.teacherName || 'Mr. Mithilesh';
                    document.querySelector('.topbar-teacher').innerHTML =
                        '<span class="dot-live"></span> ' + (settings.teacherName || 'Mr. Mithilesh');
                    applyDarkMode(settings.darkMode || false);
                }
                await renderToday(currentDate);
                console.log('✅ R.P.S. School Practical Lesson Planner initialized!');
                console.log('🏫 R.P.S. School, Bihar Sharif (Nalanda) | Session 2026–2027');
                console.log('👨‍🏫 Teacher: Mr. Mithilesh');
                console.log('📅 Periods: 2nd – 7th | Smart diverse scheduling active');
            }

            init().catch(err => {
                console.error('Initialization error:', err);
                alert('Failed to initialize. Please ensure IndexedDB is supported in your browser.');
            });

            // Expose for debugging
            window.plannerAPI = {
                getDiverseRecommendations,
                renderToday,
                renderCalendar,
                renderAnalytics,
                getScheduleForDate,
                getAllProgress,
                db,
                currentDate,
                switchView,
                PERIODS,
            };
        })();
    </script>
</body>
